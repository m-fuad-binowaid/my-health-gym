{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --filter @workspace/my-health-gym run dev",
    "build": "pnpm --filter @workspace/my-health-gym run build",
    "preview": "pnpm --filter @workspace/my-health-gym run serve",
    "typecheck": "pnpm --filter @workspace/my-health-gym run typecheck",
    "build:all": "pnpm run typecheck:all && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck:all": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
